# Supabase 프로젝트 설정 → API 에서 복사한다.

# 클라이언트에 노출되어도 되는 값 (RLS 가 보호한다)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. RLS 를 우회하므로 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다 (§5.3, §7).
SUPABASE_SERVICE_ROLE_KEY=

# M1 한정: /write 를 막는 관리자 비밀번호 한 개. M2 에서 세션으로 교체된다 (§6 M2-1).
ADMIN_PASSWORD=
# supabase/seed.sql 로 만든 관리자 profile 의 UUID. M1 의 모든 글이 이 사람 앞으로 저장된다.
ADMIN_AUTHOR_ID=

# RSS 의 <link>, og:image 절대 경로, 그리고 매직링크가 돌아올 주소에 쓰인다.
# 비어 있으면 요청 호스트로 폴백하지만, 배포 환경에서는 반드시 실제 도메인을 넣을 것 —
# 이 값이 틀리면 로그인 메일의 링크가 엉뚱한 곳을 가리킨다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
