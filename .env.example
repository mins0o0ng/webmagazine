# Supabase 프로젝트 설정 → API 에서 복사한다.

# 클라이언트에 노출되어도 되는 값 (RLS 가 보호한다)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. RLS 를 우회하므로 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다 (§5.3, §7).
# 편집실(/editor)의 초대·권한 부여, 가입 시 초대장 확인, npm run db:admin 에 쓰인다.
SUPABASE_SERVICE_ROLE_KEY=

# npm run db:migrate 에만 쓰인다. 앱은 이 값을 읽지 않는다.
# Connect → Session pooler 의 문자열을 **그대로** 복사한다. [YOUR-PASSWORD] 는
# 지우지 말고 그대로 둔다.
# service_role 키로는 DDL 을 돌릴 수 없어서 이 값이 따로 필요하다.
DATABASE_URL=postgresql://postgres.YOUR-REF:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres

# 데이터베이스 비밀번호 **원문**. URL 인코딩하지 않는다 — scripts/db-url.mjs 가
# 대신 한다. @ : / ? # % 공백 무엇이 들어 있어도 된다.
#
# 왜 URL 에 직접 넣지 않는가: Supabase 는 비밀번호에 특수문자를 요구하는데,
# 그 특수문자가 URL 문법과 충돌한다(@ 는 호스트 구분자, : 는 포트, / 는 경로).
# 사람에게 %40 으로 바꿔 적으라고 시키면 반드시 어딘가 틀린다.
SUPABASE_DB_PASSWORD=

# --- 편집실 열쇠 (임시) -----------------------------------------------------
# 넣으면 /login 에 비밀번호 한 칸짜리 "편집실 열쇠" 가 생긴다. 매직링크 메일을
# 기다리지 않고 이 계정으로 바로 로그인한다. 비어 있으면 그 칸도, 서버 액션도 없다.
#
#   npm run db:admin -- me@example.com --password '정할비밀번호'
#   ADMIN_EMAIL=me@example.com
#
# 비밀번호 자체는 여기 두지 않는다 — Supabase 의 계정 비밀번호이고, 이 변수는
# "어느 계정으로 들어가는가" 만 정한다.
#
# 임시 통로다. 다른 사람을 초대해 각자 자기 계정으로 들어가기 시작하면 지울 것.
# 이 값 하나가 새면 지면 전체가 넘어간다.
ADMIN_EMAIL=

# M2-1 에서 ADMIN_PASSWORD 와 ADMIN_AUTHOR_ID 가 사라졌다.
# /write 는 로그인 세션 + profiles.can_write 로 열리고, 글의 필자는 세션에서 나온다.
# 기존 .env.local 에 남아 있다면 지워도 된다.

# RSS 의 <link>, og:image 절대 경로, 그리고 매직링크가 돌아올 주소에 쓰인다.
# 비어 있으면 요청 호스트로 폴백하지만, 배포 환경에서는 반드시 실제 도메인을 넣을 것 —
# 이 값이 틀리면 로그인 메일의 링크가 엉뚱한 곳을 가리킨다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- 노션 자동 동기화 (M2-4) -------------------------------------------------
# 없으면 동기화 기능 전체가 없는 것으로 친다. 편집실에도 버튼이 안 뜬다.
#
# 1. https://www.notion.so/my-integrations → New integration → Internal
#    → Secret 을 복사해 NOTION_TOKEN 에 넣는다.
# 2. 노션에서 "웹매거진 원고" 데이터베이스를 열고 우상단 ⋯ → 연결 → 그 통합을 고른다.
#    이걸 빼먹으면 토큰이 맞아도 404 가 난다(가장 흔한 실수).
# 3. 데이터베이스 URL 의 32자리 문자열이 NOTION_DATABASE_ID 다.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Vercel Cron 이 /api/sync/notion 을 부를 때 쓰는 비밀값. 아무 긴 문자열이면 된다.
# 없으면 그 경로는 503 으로 닫힌다 — 열어두면 누구나 반복 호출해 노션 API 한도를
# 태우고 Storage 를 채울 수 있다. 편집실의 "지금 동기화" 버튼은 이 값과 무관하다.
CRON_SECRET=
