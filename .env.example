# Supabase 프로젝트 설정 → API 에서 복사한다.

# 클라이언트에 노출되어도 되는 값 (RLS 가 보호한다)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. RLS 를 우회하므로 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다 (§5.3, §7).
SUPABASE_SERVICE_ROLE_KEY=

# M1 한정: /write 를 막는 관리자 비밀번호 한 개. M2 에서 세션으로 교체된다 (§6 M2-1).
ADMIN_PASSWORD=
# supabase/seed.sql 로 만든 관리자 profile 의 UUID. M1 의 모든 글이 이 사람 앞으로 저장된다.
ADMIN_AUTHOR_ID=

# RSS 와 정규 URL 생성에 쓰인다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
