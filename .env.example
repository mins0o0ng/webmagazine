# Supabase 프로젝트 설정 → API 에서 복사한다.

# 클라이언트에 노출되어도 되는 값 (RLS 가 보호한다)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. RLS 를 우회하므로 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다 (§5.3, §7).
# 편집실(/editor)의 초대·권한 부여, 가입 시 초대장 확인, npm run db:admin 에 쓰인다.
SUPABASE_SERVICE_ROLE_KEY=

# npm run db:migrate 에만 쓰인다. 앱은 이 값을 읽지 않는다.
# Settings → Database → Connection string → URI. [YOUR-PASSWORD] 자리는 프로젝트를
# 만들 때 정한 데이터베이스 비밀번호다(잊었으면 같은 화면에서 재설정).
# service_role 키로는 DDL 을 돌릴 수 없어서 이 값이 따로 필요하다.
DATABASE_URL=

# --- 편집실 열쇠 (임시) -----------------------------------------------------
# 넣으면 /login 에 비밀번호 한 칸짜리 "편집실 열쇠" 가 생긴다. 매직링크 메일을
# 기다리지 않고 이 계정으로 바로 로그인한다. 비어 있으면 그 칸도, 서버 액션도 없다.
#
#   npm run db:admin -- me@example.com --password '정할비밀번호'
#   ADMIN_EMAIL=me@example.com
#
# 비밀번호 자체는 여기 두지 않는다 — Supabase 의 계정 비밀번호이고, 이 변수는
# "어느 계정으로 들어가는가" 만 정한다.
#
# 임시 통로다. 다른 사람을 초대해 각자 자기 계정으로 들어가기 시작하면 지울 것.
# 이 값 하나가 새면 지면 전체가 넘어간다.
ADMIN_EMAIL=

# M2-1 에서 ADMIN_PASSWORD 와 ADMIN_AUTHOR_ID 가 사라졌다.
# /write 는 로그인 세션 + profiles.can_write 로 열리고, 글의 필자는 세션에서 나온다.
# 기존 .env.local 에 남아 있다면 지워도 된다.

# RSS 의 <link>, og:image 절대 경로, 그리고 매직링크가 돌아올 주소에 쓰인다.
# 비어 있으면 요청 호스트로 폴백하지만, 배포 환경에서는 반드시 실제 도메인을 넣을 것 —
# 이 값이 틀리면 로그인 메일의 링크가 엉뚱한 곳을 가리킨다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
